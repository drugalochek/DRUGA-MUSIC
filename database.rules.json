{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "catalog": {
      "tracks": {
        ".read": true,
        ".indexOn": ["addedAt", "ownerId"],
        "$id": {
          ".write": "auth != null && (data.exists() ? data.child('ownerId').val() === auth.uid : newData.child('ownerId').val() === auth.uid)",
          ".validate": "newData.hasChildren(['title', 'artist', 'ownerId']) && newData.child('ownerId').val() === auth.uid"
        }
      },
      "audio": {
        ".read": true,
        "$id": {
          ".write": "auth != null && root.child('catalog/tracks/' + $id + '/ownerId').val() === auth.uid"
        }
      }
    }
  }
}

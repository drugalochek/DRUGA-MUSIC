<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Sonora.Controls"
        x:Class="Sonora.MainWindow"
        Title="SONORA"
        Width="1280" Height="850"
        MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#080B12"
        Foreground="#F5F5F8"
        FontFamily="avares://SONORA/Assets/WidockTrialBold.otf#Widock">
  <Grid RowDefinitions="72,*,Auto" ColumnDefinitions="238,*" Background="#080B12">
    <!-- Sonic Wave top bar -->
    <Border Grid.Row="0" Grid.Column="1" Background="#0B0F18" BorderBrush="#FFFFFF12" BorderThickness="0,0,0,1">
      <Grid Margin="30,0,34,0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Border Width="30" Height="30" CornerRadius="9">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#397BFF" Offset="0"/>
                <GradientStop Color="#16B8E7" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Image Source="avares://SONORA/Assets/sonora.png" Stretch="Uniform" Margin="4"/>
          </Border>
          <TextBlock Text="SONORA" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBox x:Name="HeaderSearchBox" Grid.Column="1" Classes="search-box" Width="410" Height="40" HorizontalAlignment="Center" VerticalContentAlignment="Center" Text="{Binding SearchQuery, Mode=TwoWay}" PlaceholderText="Поиск музыки, альбомов и исполнителей" TextChanged="HeaderSearchBox_TextChanged"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Classes="icon-button" Content="＋" Click="Import_Click" ToolTip.Tip="Добавить музыку"/>
          <Border Width="1" Height="26" Background="#263348" Margin="3,0"/>
          <Button Classes="profile-button" Content="{Binding ProfileName}" Click="Profile_Click" ToolTip.Tip="Профиль"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main views: all stay inside this one native window -->
    <Grid Grid.Row="1" Grid.Column="1">
      <ScrollViewer x:Name="HomePage" IsVisible="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,30,42,42" Spacing="0">
          <TextBlock Text="{Binding GreetingText}" Foreground="#8190A5" FontSize="12" Margin="0,0,0,3"/>
          <TextBlock Text="Главная" FontSize="30" FontWeight="Bold" Margin="0,0,0,18"/>
          <Border CornerRadius="18" BorderBrush="#2B5D9C" BorderThickness="1" Padding="26" Margin="0,0,0,27">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#142C4D" Offset="0"/>
                <GradientStop Color="#101E34" Offset="0.58"/>
                <GradientStop Color="#102A3C" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel VerticalAlignment="Center" Spacing="9">
                <Border Background="#1D4778" CornerRadius="5" Padding="8,4" HorizontalAlignment="Left">
                  <TextBlock Text="ТВОЯ МУЗЫКА — ТВОИ ПРАВИЛА" FontSize="8" FontWeight="Bold" Foreground="#9CCBFF" LetterSpacing="1.3"/>
                </Border>
                <TextBlock Text="Слушай своё." FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="Вся твоя музыка. В одном пространстве." FontSize="13" Foreground="#A7B9D0"/>
                <Button Classes="action" Content="＋  Добавить музыку" HorizontalAlignment="Left" Margin="0,8,0,0" Click="Import_Click"/>
              </StackPanel>
              <Grid Grid.Column="1" Width="230" Height="150" VerticalAlignment="Center">
                <Border Width="142" Height="142" CornerRadius="71" BorderBrush="#427FC0" BorderThickness="1" Opacity="0.65" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border Width="106" Height="106" CornerRadius="53" BorderBrush="#438BDA" BorderThickness="1" Opacity="0.55" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border Width="68" Height="68" CornerRadius="34" Background="#2268B5" Opacity="0.65" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                  <Border Width="4" Height="22" CornerRadius="2" Background="#A8D7FF"/>
                  <Border Width="4" Height="42" CornerRadius="2" Background="#72B9FF"/>
                  <Border Width="4" Height="58" CornerRadius="2" Background="#D2ECFF"/>
                  <Border Width="4" Height="34" CornerRadius="2" Background="#7CC8F3"/>
                  <Border Width="4" Height="48" CornerRadius="2" Background="#A8D7FF"/>
                  <Border Width="4" Height="19" CornerRadius="2" Background="#72B9FF"/>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Text="Любимые исполнители" FontSize="19" FontWeight="Bold"/>
            <TextBlock Grid.Column="1" Text="{Binding ArtistCountText}" Foreground="#82829A" FontSize="11" VerticalAlignment="Center"/>
          </Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="-6,0,-6,13">
            <ItemsControl ItemsSource="{Binding Artists}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Width="94" Margin="6,5,6,8" Spacing="7">
                    <Border Width="84" Height="84" CornerRadius="42" HorizontalAlignment="Center" ClipToBounds="True" Background="#172B46" BorderBrush="#2A4568" BorderThickness="1">
                      <Grid>
                        <controls:TrackArtwork ArtworkPath="{Binding ArtworkPath}"/>
                        <TextBlock Text="{Binding Initial}" IsVisible="{Binding ShowInitial}" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#C6DFFF"/>
                      </Grid>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="2"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Grid ColumnDefinitions="*,Auto" Margin="0,7,0,8">
            <TextBlock Text="Жанр часа" FontSize="19" FontWeight="Bold"/>
            <TextBlock Grid.Column="1" Text="Обновляется автоматически" Foreground="#82829A" FontSize="10" VerticalAlignment="Center"/>
          </Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="-6,0,-6,12">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Width="170" Height="96" CornerRadius="13" Padding="14" Background="#284B9B">
                <TextBlock Text="Из твоих жанров" FontSize="16" FontWeight="Bold" VerticalAlignment="Bottom"/>
              </Border>
              <Border Width="170" Height="96" CornerRadius="13" Padding="14" Background="#126A92">
                <TextBlock Text="Свежее звучание" FontSize="16" FontWeight="Bold" VerticalAlignment="Bottom"/>
              </Border>
              <Border Width="170" Height="96" CornerRadius="13" Padding="14" Background="#254A65">
                <TextBlock Text="На повторе" FontSize="16" FontWeight="Bold" VerticalAlignment="Bottom"/>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <Grid ColumnDefinitions="*,Auto" Margin="0,7,0,8">
            <TextBlock Text="Миксы для тебя" FontSize="19" FontWeight="Bold"/>
            <TextBlock Grid.Column="1" Text="3 подборки" Foreground="#82829A" FontSize="11" VerticalAlignment="Center"/>
          </Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="-6,0,-6,14">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <StackPanel Width="200" Spacing="5">
                <Border Width="200" Height="200" CornerRadius="15" ClipToBounds="True" BorderBrush="#315B91" BorderThickness="1">
                  <Grid Background="#10233B">
                    <Border Width="172" Height="172" CornerRadius="86" BorderBrush="#3E75B4" BorderThickness="1" Opacity="0.65" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-55,0"/>
                    <Border Width="128" Height="128" CornerRadius="64" BorderBrush="#4D8BD0" BorderThickness="1" Opacity="0.55" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-32,0"/>
                    <StackPanel Margin="17" VerticalAlignment="Bottom" Spacing="4">
                      <TextBlock Text="SONORA / DAILY" FontSize="8" Foreground="#9CCBFF" LetterSpacing="1.6"/>
                      <TextBlock Text="DAILY" FontSize="31" FontWeight="Bold"/>
                      <TextBlock Text="01  /  YOUR ROTATION" FontSize="8" Foreground="#8CA7C6" LetterSpacing="1"/>
                    </StackPanel>
                    <Border Width="33" Height="33" CornerRadius="17" Background="#2C78D6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0">
                      <TextBlock Text="▶" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </Grid>
                </Border>
                <TextBlock Text="Микс дня" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="Подборка на сегодня" FontSize="11" Foreground="#82829A"/>
              </StackPanel>
              <StackPanel Width="200" Spacing="5">
                <Border Width="200" Height="200" CornerRadius="15" ClipToBounds="True" BorderBrush="#294A70" BorderThickness="1">
                  <Grid Background="#101B2B">
                    <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                      <Border Width="5" Height="45" CornerRadius="3" Background="#3D77B6"/>
                      <Border Width="5" Height="82" CornerRadius="3" Background="#5D9DDB"/>
                      <Border Width="5" Height="116" CornerRadius="3" Background="#A6D7FF"/>
                      <Border Width="5" Height="72" CornerRadius="3" Background="#6EB5EC"/>
                      <Border Width="5" Height="96" CornerRadius="3" Background="#4E8AC8"/>
                    </StackPanel>
                    <StackPanel Margin="17" VerticalAlignment="Bottom" Spacing="3">
                      <TextBlock Text="7 DAYS / CURATED" FontSize="8" Foreground="#9ABFE6" LetterSpacing="1.5"/>
                      <TextBlock Text="WEEKLY" FontSize="27" FontWeight="Bold"/>
                      <TextBlock Text="THE SOUND OF YOUR WEEK" FontSize="7" Foreground="#8097B4" LetterSpacing="1"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <TextBlock Text="Микс недели" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="Твои прослушивания за неделю" FontSize="11" Foreground="#82829A"/>
              </StackPanel>
              <StackPanel Width="200" Spacing="5">
                <Border Width="200" Height="200" CornerRadius="15" ClipToBounds="True" BorderBrush="#2B596E" BorderThickness="1">
                  <Grid Background="#102731">
                    <Border Width="155" Height="155" CornerRadius="78" BorderBrush="#397E91" BorderThickness="1" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border Width="112" Height="112" CornerRadius="56" BorderBrush="#58AFC1" BorderThickness="1" Opacity="0.65" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border Width="66" Height="66" CornerRadius="33" Background="#1B5A6D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <StackPanel Margin="17" VerticalAlignment="Bottom" Spacing="3">
                      <TextBlock Text="PERSONAL SELECTION" FontSize="8" Foreground="#A2D8E2" LetterSpacing="1.3"/>
                      <TextBlock Text="FOR YOU" FontSize="26" FontWeight="Bold"/>
                      <TextBlock Text="MADE AROUND YOUR TASTE" FontSize="7" Foreground="#8EB6C1" LetterSpacing="0.8"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <TextBlock Text="Для тебя" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="Музыка под твой вкус" FontSize="11" Foreground="#82829A"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <Grid ColumnDefinitions="*,Auto" Margin="0,7,0,8">
            <TextBlock Text="100% для тебя" FontSize="19" FontWeight="Bold"/>
            <TextBlock Grid.Column="1" Text="На основе предпочтений" Foreground="#82829A" FontSize="11" VerticalAlignment="Center"/>
          </Grid>
          <Border Width="260" HorizontalAlignment="Left" Classes="music-card" Padding="0" Margin="0,0,0,18">
            <StackPanel Spacing="0">
              <Border Height="205" CornerRadius="14" ClipToBounds="True">
                <Grid>
                  <controls:TrackArtwork ArtworkPath="{Binding ForYouArtworkPath}"/>
                  <Border>
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#161D2C22" Offset="0"/>
                        <GradientStop Color="#E508101D" Offset="1"/>
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>
                  <StackPanel Margin="15" VerticalAlignment="Bottom" Spacing="4">
                    <TextBlock Text="100% FOR YOU" FontSize="9" FontWeight="Bold" Foreground="#A9D3FF" LetterSpacing="2"/>
                    <TextBlock Text="{Binding ForYouArtistName}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ForYouTrackCountText}" FontSize="10" Foreground="#C2D0E2"/>
                  </StackPanel>
                  <Button Classes="mix-play-button" Content="▶" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,13,14" IsEnabled="{Binding HasForYouArtist}" Click="ForYou_Click"/>
                </Grid>
              </Border>
              <TextBlock Text="Треки исполнителя, который чаще всего встречается в твоей библиотеке" FontSize="10" Foreground="#8190A5" TextWrapping="Wrap" Margin="12,10,12,12"/>
            </StackPanel>
          </Border>
          <Grid ColumnDefinitions="*,Auto" Margin="0,3,0,8">
            <TextBlock Text="Недавно добавленные" FontSize="19" FontWeight="Bold"/>
            <TextBlock Grid.Column="1" Text="{Binding TrackCountText}" Foreground="#82829A" FontSize="11" VerticalAlignment="Center"/>
          </Grid>
          <Border Classes="music-card" Padding="7">
            <StackPanel>
              <TextBlock Text="{Binding EmptyLibraryText}" IsVisible="{Binding IsLibraryEmpty}" Foreground="#82829A" FontSize="12" Margin="12"/>
              <ItemsControl ItemsSource="{Binding VisibleTracks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="track-row" Background="Transparent" BorderThickness="0" Padding="7" HorizontalContentAlignment="Stretch" Click="Track_Click">
                      <Grid ColumnDefinitions="44,*,Auto,24" ColumnSpacing="11">
                        <Border Width="42" Height="42" CornerRadius="9" ClipToBounds="True">
                          <controls:TrackArtwork ArtworkPath="{Binding ArtworkPath}"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                          <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Artist}" FontSize="10" Foreground="#82829A" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="10" Foreground="#82829A" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding FavoriteGlyph}" FontSize="15" Foreground="#5EA6FF" VerticalAlignment="Center" HorizontalAlignment="Center" PointerPressed="Favorite_PointerPressed"/>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer x:Name="ExplorePage" IsVisible="False" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,20,22,30" Spacing="10">
          <TextBlock Text="Обзор" FontSize="30" FontWeight="Bold"/>
          <TextBlock Text="Исполнители" FontSize="17" FontWeight="Bold"/>
          <ItemsControl ItemsSource="{Binding Artists}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="music-card" Width="175" Padding="13" Margin="0,0,10,10">
                  <StackPanel Spacing="5">
                    <Border Width="66" Height="66" CornerRadius="33" Background="#245DAD" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding Initial}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding CountText}" FontSize="10" Foreground="#82829A"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Все треки" FontSize="17" FontWeight="Bold" Margin="0,10,0,0"/>
          <ItemsControl ItemsSource="{Binding VisibleTracks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="track-row" Background="Transparent" BorderThickness="0" Padding="8" HorizontalContentAlignment="Stretch" Click="Track_Click">
                  <Grid ColumnDefinitions="44,*,Auto,24" ColumnSpacing="11">
                    <Border Width="42" Height="42" CornerRadius="9" ClipToBounds="True"><controls:TrackArtwork ArtworkPath="{Binding ArtworkPath}"/></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                      <TextBlock Text="{Binding Title}" FontSize="12"/>
                      <TextBlock Text="{Binding Artist}" FontSize="10" Foreground="#82829A"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="10" Foreground="#82829A" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding FavoriteGlyph}" FontSize="15" Foreground="#5EA6FF" VerticalAlignment="Center" HorizontalAlignment="Center" PointerPressed="Favorite_PointerPressed"/>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer x:Name="FavoritesPage" IsVisible="False" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,20,22,30" Spacing="12">
          <TextBlock Text="Избранное" FontSize="30" FontWeight="Bold"/>
          <Border CornerRadius="15" Padding="18" Background="#1B2450">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <Border Width="66" Height="66" CornerRadius="12" Background="#317CEB">
                <TextBlock Text="♥" FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="Любимые треки" FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="{Binding FavoriteCountText}" FontSize="11" Foreground="#C5D9FF"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding FavoriteTracks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="track-row" Background="Transparent" BorderThickness="0" Padding="8" HorizontalContentAlignment="Stretch" Click="Track_Click">
                  <Grid ColumnDefinitions="44,*,Auto,24" ColumnSpacing="11">
                    <Border Width="42" Height="42" CornerRadius="9" ClipToBounds="True"><controls:TrackArtwork ArtworkPath="{Binding ArtworkPath}"/></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                      <TextBlock Text="{Binding Title}" FontSize="12"/>
                      <TextBlock Text="{Binding Artist}" FontSize="10" Foreground="#82829A"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="♥" Foreground="#4B9AFF" VerticalAlignment="Center"/>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding EmptyFavoritesText}" IsVisible="{Binding IsFavoritesEmpty}" Foreground="#82829A" FontSize="12" Margin="10"/>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer x:Name="SearchPage" IsVisible="False" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,20,22,30" Spacing="12">
          <TextBlock Text="Поиск" FontSize="30" FontWeight="Bold"/>
          <TextBox x:Name="SearchBox" Classes="search-box" Text="{Binding SearchQuery, Mode=TwoWay}" PlaceholderText="Трек, исполнитель или альбом" TextChanged="SearchBox_TextChanged"/>
          <TextBlock Text="Результаты" FontSize="17" FontWeight="Bold"/>
          <ItemsControl ItemsSource="{Binding VisibleTracks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="track-row" Background="Transparent" BorderThickness="0" Padding="8" HorizontalContentAlignment="Stretch" Click="Track_Click">
                  <Grid ColumnDefinitions="44,*,Auto,24" ColumnSpacing="11">
                    <Border Width="42" Height="42" CornerRadius="9" ClipToBounds="True"><controls:TrackArtwork ArtworkPath="{Binding ArtworkPath}"/></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                      <TextBlock Text="{Binding Title}" FontSize="12"/>
                      <TextBlock Text="{Binding Artist}" FontSize="10" Foreground="#82829A"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="10" Foreground="#82829A" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding FavoriteGlyph}" FontSize="15" Foreground="#5EA6FF" VerticalAlignment="Center" HorizontalAlignment="Center" PointerPressed="Favorite_PointerPressed"/>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Ничего не найдено. Добавь музыку в библиотеку или измени запрос." IsVisible="{Binding IsSearchEmpty}" Foreground="#82829A" FontSize="12"/>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer x:Name="ProfilePage" IsVisible="False" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,20,22,30" Spacing="14">
          <TextBlock Text="Профиль" FontSize="30" FontWeight="Bold"/>
          <Border CornerRadius="18" BorderBrush="#294B72" BorderThickness="1" Padding="22">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#142943" Offset="0"/>
                <GradientStop Color="#101B2B" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
              <Border Width="82" Height="82" CornerRadius="41" Background="#1C385B" BorderBrush="#4D8ACB" BorderThickness="2" ClipToBounds="True">
                <Grid>
                  <TextBlock Text="◎" FontSize="31" Foreground="#9DCBFF" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowProfileAvatarPlaceholder}"/>
                  <Image Source="{Binding ProfileAvatar}" Stretch="UniformToFill" IsVisible="{Binding HasProfileAvatar}"/>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                <TextBlock Text="SONORA LISTENER" FontSize="9" FontWeight="Bold" Foreground="#8DB8E8" LetterSpacing="1.7"/>
                <TextBlock Text="{Binding ProfileName}" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="{Binding AccountStatusText}" FontSize="11" Foreground="#A2B4C9"/>
                <TextBlock Text="{Binding Email}" FontSize="11" Foreground="#7D91AA"/>
              </StackPanel>
              <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4">
                <TextBlock Text="{Binding TrackCountText}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Right"/>
                <TextBlock Text="В БИБЛИОТЕКЕ" FontSize="8" Foreground="#7D91AA" LetterSpacing="1.2"/>
                <TextBlock Text="{Binding FavoriteCountText}" FontSize="11" Foreground="#9CB6D3" HorizontalAlignment="Right" Margin="0,7,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
          <TextBlock Text="Настройки профиля" FontSize="16" FontWeight="Bold"/>
          <TextBox Classes="search-box" PlaceholderText="Твой никнейм" Text="{Binding Nickname, Mode=TwoWay}"/>
          <StackPanel Orientation="Horizontal" Spacing="9">
            <Button Classes="action" Content="Изменить аватар" Click="Avatar_Click"/>
            <Button Classes="nav-item" Content="Сохранить профиль" Click="SaveProfile_Click"/>
          </StackPanel>
          <TextBlock Text="Аккаунт" FontSize="16" FontWeight="Bold" Margin="0,10,0,0"/>
          <Button Classes="settings-row" Content="Привязка аккаунтов и вход  ›" Click="Accounts_Click"/>
          <Button Classes="settings-row" Content="Настройки приложения  ›" Click="Settings_Click"/>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer x:Name="AccountsPage" IsVisible="False" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,20,22,30" Spacing="13" MaxWidth="620" HorizontalAlignment="Left">
          <Button Classes="nav-item" Content="‹  Назад в профиль" HorizontalAlignment="Left" Click="Profile_Click"/>
          <TextBlock Text="Аккаунты" FontSize="30" FontWeight="Bold"/>
          <TextBlock Text="Вход в SONORA и подключённые способы авторизации" FontSize="12" Foreground="#82829A"/>
          <Border Classes="music-card" Padding="18">
            <StackPanel Spacing="10">
              <TextBlock Text="Google" FontSize="16" FontWeight="Bold"/>
              <TextBlock Text="Подключи Google к текущему профилю или используй его для первого входа." FontSize="11" Foreground="#82829A" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding GoogleProviderStatusText}" FontSize="11" Foreground="#79B8FF"/>
              <Button Classes="action" Content="{Binding GoogleButtonText}" IsEnabled="{Binding CanLinkGoogle}" HorizontalAlignment="Left" Click="GoogleSignIn_Click"/>
            </StackPanel>
          </Border>
          <Border Classes="music-card" Padding="18" IsVisible="{Binding CanAddPassword}">
            <StackPanel Spacing="10">
              <TextBlock Text="Добавить пароль к текущему аккаунту" FontSize="16" FontWeight="Bold"/>
              <TextBlock Text="{Binding PasswordProviderStatusText}" FontSize="11" Foreground="#82829A"/>
              <TextBox x:Name="LinkPasswordBox" Classes="search-box" PasswordChar="●" PlaceholderText="Новый пароль (минимум 6 символов)"/>
              <Button Classes="action" Content="Добавить пароль" HorizontalAlignment="Left" Click="AddPassword_Click"/>
            </StackPanel>
          </Border>
          <Border Classes="music-card" Padding="18" IsVisible="{Binding ShowSignInOptions}">
            <StackPanel Spacing="10">
              <TextBlock Text="Почта и пароль" FontSize="16" FontWeight="Bold"/>
              <TextBox x:Name="EmailBox" Classes="search-box" PlaceholderText="Электронная почта"/>
              <TextBox x:Name="PasswordBox" Classes="search-box" PasswordChar="●" PlaceholderText="Пароль"/>
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Button Classes="action" Content="Войти" Click="SignIn_Click"/>
                <Button Classes="nav-item" Content="Создать аккаунт" Click="Register_Click"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding AuthMessage}" Foreground="#79B8FF" FontSize="11" TextWrapping="Wrap"/>
          <Button Classes="settings-row" Content="Выйти из аккаунта" IsVisible="{Binding IsSignedIn}" Click="SignOut_Click"/>
          <TextBlock Text="{Binding PasswordProviderStatusText}" Foreground="#82829A" FontSize="10" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer x:Name="SettingsPage" IsVisible="False" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,20,22,30" Spacing="12">
          <Button Classes="nav-item" Content="‹  Назад в профиль" HorizontalAlignment="Left" Click="Profile_Click"/>
          <TextBlock Text="Настройки" FontSize="30" FontWeight="Bold"/>
          <TextBlock Text="Параметры приложения SONORA" Foreground="#82829A" FontSize="12"/>
          <Border Classes="music-card" Padding="16">
            <StackPanel Spacing="6">
              <TextBlock Text="Воспроизведение" FontSize="15" FontWeight="Bold"/>
              <TextBlock Text="Звук выводится через NAudio. Управление очередью и громкостью будет расширяться в следующих итерациях." FontSize="11" Foreground="#82829A" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Full player overlay, still inside the same window -->
      <Border x:Name="NowPlayingOverlay" IsVisible="False" Background="#080B12">
        <Grid RowDefinitions="Auto,*,Auto" Margin="24">
          <Button Classes="icon-button" Content="⌄" HorizontalAlignment="Left" Click="ClosePlayer_Click"/>
          <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="420">
            <Border Width="360" Height="360" CornerRadius="18" Background="#1B3766" ClipToBounds="True">
              <Image Source="{Binding CurrentArtwork}" Stretch="UniformToFill"/>
            </Border>
            <TextBlock Text="{Binding CurrentTrackTitle}" FontSize="22" FontWeight="Bold" TextAlignment="Center"/>
            <TextBlock Text="{Binding CurrentTrackArtist}" FontSize="14" Foreground="#82829A" TextAlignment="Center"/>
            <StackPanel Spacing="4">
              <Slider x:Name="PlayerSeek" Minimum="0" Maximum="100" Value="{Binding Progress}" PointerReleased="Seek_Released"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding CurrentTimeText}" FontSize="10" Foreground="#82829A"/>
                <TextBlock Grid.Column="1" Text="{Binding DurationText}" FontSize="10" Foreground="#82829A"/>
              </Grid>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
              <TextBlock Text="Громкость" FontSize="10" Foreground="#82829A" VerticalAlignment="Center"/>
              <Slider Width="150" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="22">
              <Button Classes="icon-button" Content="|◀" Click="Previous_Click"/>
              <Button Classes="action" Width="54" Height="54" Content="{Binding PlayButtonGlyph}" Click="PlayPause_Click"/>
              <Button Classes="icon-button" Content="▶|" Click="Next_Click"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Mini player -->
    <Border x:Name="MiniPlayer" Grid.Row="2" Grid.Column="1" IsVisible="{Binding HasCurrentTrack}" Background="#0D1420" BorderBrush="#FFFFFF12" BorderThickness="1" CornerRadius="13" Margin="12,7" Padding="8" PointerPressed="MiniPlayer_PointerPressed">
      <Grid RowDefinitions="*,2" ColumnDefinitions="44,*,Auto,Auto" ColumnSpacing="10">
        <Border Width="42" Height="42" CornerRadius="9" Background="#244D91">
          <Image Source="{Binding CurrentArtwork}" Stretch="UniformToFill"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
          <TextBlock Text="{Binding CurrentTrackTitle}" FontSize="12" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding CurrentTrackArtist}" FontSize="10" Foreground="#82829A"/>
        </StackPanel>
        <Button Grid.Column="2" Classes="icon-button" Content="{Binding PlayButtonGlyph}" Click="PlayPause_Click"/>
        <Button Grid.Column="3" Classes="icon-button" Content="×" Click="CloseMini_Click"/>
        <ProgressBar Grid.Row="1" Grid.ColumnSpan="4" Height="2" Minimum="0" Maximum="100" Value="{Binding Progress}" Background="#FFFFFF18" Foreground="#397BFF"/>
      </Grid>
    </Border>

    <!-- Native desktop navigation -->
    <Border Grid.Column="0" Grid.RowSpan="3" Background="#090D15" BorderBrush="#FFFFFF12" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,25,18,34" Spacing="11">
          <Border Width="34" Height="34" CornerRadius="11" Background="#176BFF">
            <Image Source="avares://SONORA/Assets/sonora.png" Stretch="Uniform" Margin="4"/>
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="0">
            <TextBlock Text="SONORA" FontSize="17" FontWeight="Bold" LetterSpacing="1.4" FontFamily="avares://SONORA/Assets/WidockTrialBold.otf#Widock"/>
            <TextBlock Text="MUSIC PLAYER" FontSize="8" Foreground="#64758D" LetterSpacing="2"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="14,0,14,0" Spacing="5">
          <TextBlock Text="МЕНЮ" FontSize="9" FontWeight="Bold" Foreground="#53647B" Margin="12,0,0,8" LetterSpacing="1.8"/>
          <Button Classes="nav-item active" Tag="home" Content="⌂     Главная" Click="Nav_Click"/>
          <Button Classes="nav-item" Tag="explore" Content="◈     Обзор" Click="Nav_Click"/>
          <Button Classes="nav-item" Tag="favorites" Content="♡     Избранное" Click="Nav_Click"/>
          <Button Classes="nav-item" Tag="search" Content="⌕     Поиск" Click="Nav_Click"/>
          <Border Height="1" Background="#FFFFFF12" Margin="8,17,8,13"/>
          <TextBlock Text="ТВОЯ SONORA" FontSize="9" FontWeight="Bold" Foreground="#53647B" Margin="12,0,0,8" LetterSpacing="1.8"/>
          <Button Classes="nav-item" Content="◎     Профиль" Click="Profile_Click"/>
          <Button Classes="nav-item" Content="⌘     Аккаунты" Click="Accounts_Click"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="14,0,14,20" Spacing="8">
          <Border Background="#101A2B" BorderBrush="#FFFFFF12" BorderThickness="1" CornerRadius="14" Padding="13">
            <StackPanel Spacing="6">
              <TextBlock Text="ТВОЯ МУЗЫКА" FontSize="9" Foreground="#7792B5" FontWeight="Bold" LetterSpacing="1.3"/>
              <TextBlock Text="{Binding TrackCountText}" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock Text="Локальная библиотека" FontSize="10" Foreground="#708099"/>
              <Button Classes="sidebar-add" Content="＋  Добавить треки" Click="Import_Click"/>
            </StackPanel>
          </Border>
          <Button Classes="nav-item" Content="⚙     Настройки" Click="Settings_Click"/>
          <TextBlock Text="SONORA  •  DESKTOP" FontSize="8" Foreground="#46556A" Margin="12,6,0,0" LetterSpacing="1.2"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
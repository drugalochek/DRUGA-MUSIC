<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SONORA</AssemblyName>
    <RootNamespace>Sonora</RootNamespace>
    <StartupObject>Sonora.Program</StartupObject>
    <ApplicationIcon>Assets\sonora.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>SONORA</Product>
    <Company>SONORA</Company>
    <Description>SONORA — музыкальный плеер для Windows</Description>
    <Copyright>© SONORA</Copyright>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <Prefer32Bit>false</Prefer32Bit>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Security" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\Widock.otf" LogicalName="Widock.otf" />
    <EmbeddedResource Include="Assets\logo.png" LogicalName="logo.png" />
    <EmbeddedResource Include="Assets\sonora.ico" LogicalName="sonora.ico" />
  </ItemGroup>
</Project>

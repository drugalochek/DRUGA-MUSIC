<Window x:Class="DrugaMusic.NowPlayingWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SONORA · Сейчас играет" Width="1040" Height="700" MinWidth="860" MinHeight="580"
 WindowStartupLocation="CenterOwner" Background="#07090E" Foreground="White"
 FontFamily="/SONORA;component/Assets/#Widock">
 <Grid Margin="28">
  <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid Grid.Column="0" Margin="0,0,28,0">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel VerticalAlignment="Center">
    <Border Width="370" Height="370" Background="#101B2D" BorderBrush="#367FD9" BorderThickness="1" ClipToBounds="True" HorizontalAlignment="Center">
     <Image x:Name="Cover" Stretch="UniformToFill"/>
    </Border>
    <TextBlock x:Name="TitleText" Text="Ничего не играет" FontSize="25" FontWeight="Bold" TextAlignment="Center" Margin="0,22,0,0" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="ArtistText" Foreground="#A1B0C5" FontSize="13" TextAlignment="Center" Margin="0,7,0,0"/>
    <TextBlock x:Name="AlbumText" Foreground="#6F8099" FontSize="10" TextAlignment="Center" Margin="0,5,0,0"/>
   </StackPanel>
   <StackPanel Grid.Row="1" Margin="12,18,12,0">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="PositionText" Text="0:00" Foreground="#8191A8" FontSize="10" VerticalAlignment="Center"/>
     <Slider x:Name="Seek" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="Seek_ValueChanged" PreviewMouseLeftButtonDown="Seek_MouseDown" PreviewMouseLeftButtonUp="Seek_MouseUp"/>
     <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" Foreground="#8191A8" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
     <Button Content="|◀" Width="48" Height="40" Click="Previous_Click" Background="#101722"/>
     <Button x:Name="PlayButton" Content="Ⅱ" Width="58" Height="40" Margin="12,0" Background="{StaticResource AccentGradient}" BorderBrush="#68AEFF" Click="Play_Click"/>
     <Button Content="▶|" Width="48" Height="40" Click="Next_Click" Background="#101722"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
     <TextBlock Text="ГРОМКОСТЬ" Foreground="#7D8EA7" FontSize="9" VerticalAlignment="Center" Margin="0,0,10,0"/>
     <Slider x:Name="Volume" Width="150" Minimum="0" Maximum="1" Value="0.75" ValueChanged="Volume_ValueChanged"/>
    </StackPanel>
   </StackPanel>
  </Grid>
  <Border Grid.Column="1" Background="#0A0E16" BorderBrush="#24354E" BorderThickness="1,0,0,0" Padding="22">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
     <TextBlock Text="SONORA  /  PLAYER" Foreground="#65A9FF" FontSize="9"/>
     <TextBlock Text="Очередь воспроизведения" FontSize="21" FontWeight="Bold" Margin="0,7,0,0"/>
    </StackPanel>
    <ListBox x:Name="QueueList" Background="Transparent" BorderThickness="0" Foreground="White" SelectionChanged="QueueList_SelectionChanged">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,12"/><Setter Property="BorderBrush" Value="#1C293B"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
       <Border x:Name="row" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="#111D2F"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="row" Property="Background" Value="#142B49"/><Setter TargetName="row" Property="BorderBrush" Value="#367FD9"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
     </Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate>
      <StackPanel>
       <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#F1F5FC" TextTrimming="CharacterEllipsis" FontSize="11"/>
       <TextBlock Text="{Binding Artist}" Foreground="#8494AB" FontSize="10" Margin="0,4,0,0"/>
      </StackPanel>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="↑" Width="34" Click="MoveUp_Click" Background="#111A28"/>
      <Button Content="↓" Width="34" Margin="5,0,0,0" Click="MoveDown_Click" Background="#111A28"/>
      <Button Content="Убрать" Padding="10,5" Margin="8,0,0,0" Click="Remove_Click" Background="#111A28"/>
     </StackPanel>
     <TextBlock Text="Меняй порядок или убирай треки из очереди." Foreground="#71829A" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
 </Grid>
</Window>
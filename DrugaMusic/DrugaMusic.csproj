    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DrugaMusic</RootNamespace>
    <AssemblyName>SONORA</AssemblyName>
    <Product>SONORA</Product>
    <ApplicationIcon>Assets\sonora.ico</ApplicationIcon>
    <Version>0.2.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\sonora.ico" />
    <Resource Include="Assets\WidockTrialBold.otf" />
    <Content Include="Assets\WidockTrialBold.otf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SonicWave\index.html" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="..\1795143870953.png" Link="Assets\sonora.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3595.46" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
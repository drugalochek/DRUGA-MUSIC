<Application x:Class="DrugaMusic.App" StartupUri="MainWindow.xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <Color x:Key="AccentColor">#8B5CF6</Color>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#7C3AED" Offset="0"/>
   <GradientStop Color="#287BFF" Offset="0.52"/>
   <GradientStop Color="#06B6D4" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AccentGradientSoft" StartPoint="0,0" EndPoint="1,0">
   <GradientStop Color="#25163F" Offset="0"/>
   <GradientStop Color="#101522" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="WindowBrush" Color="#0A0A12"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#16161F"/>
  <SolidColorBrush x:Key="TextBrush" Color="#F5F5F8"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#82829A"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="Background" Value="#101722"/>
   <Setter Property="BorderBrush" Value="#30283F"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,9"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#A78BFA"/><Setter TargetName="bd" Property="Background" Value="#211A35"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#302044"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.35"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Foreground" Value="#A5A2BA"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Padding" Value="14,12"/>
   <Setter Property="Margin" Value="0,2"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="nav" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="3,0,0,0" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="nav" Property="Background" Value="#201A31"/><Setter TargetName="nav" Property="BorderBrush" Value="#438FFF"/><Setter Property="Foreground" Value="White"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="nav" Property="Background" Value="#302044"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Application.Resources>
</Application>
<Application x:Class="DrugaMusic.App" StartupUri="MainWindow.xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <Color x:Key="AccentColor">#287BFF</Color>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="WindowBrush" Color="#080B12"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#111827"/>
  <SolidColorBrush x:Key="TextBrush" Color="#F4F7FC"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#93A1B5"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="Background" Value="#1A2638"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="14,9"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#263750"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#AAB6C8"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="0,2"/>
  </Style>
 </Application.Resources>
</Application>
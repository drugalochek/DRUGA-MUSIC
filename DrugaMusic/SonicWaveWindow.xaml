<Window x:Class="DrugaMusic.SonicWaveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SONORA" Width="1440" Height="960" MinWidth="1000" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#0A0A12">
    <Grid Background="#0A0A12">
        <wv2:WebView2 x:Name="Browser" DefaultBackgroundColor="#0A0A12" />
        <Border x:Name="ErrorPanel" Background="#0A0A12" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
                <TextBlock Text="SONORA" FontSize="34" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ErrorText" Text="Не удалось запустить интерфейс SONORA." Foreground="#AAB8CE" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,18,0,0"/>
                <Button Content="Повторить запуск" Click="Retry_Click" Padding="22,12" Margin="0,22,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
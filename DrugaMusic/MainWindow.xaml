<Window x:Class="DrugaMusic.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SONORA" Icon="Assets/sonora.ico" Width="1360" Height="860" MinWidth="1000" MinHeight="660"
 WindowStartupLocation="CenterScreen" Background="#000000" Foreground="{StaticResource TextBrush}">
 <Grid Background="#000000">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="94"/></Grid.RowDefinitions>
  <Grid Grid.Row="0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#000000" BorderBrush="#171B22" BorderThickness="0,0,1,0">
    <DockPanel Margin="18,26,16,18">
     <StackPanel DockPanel.Dock="Top">
      <StackPanel Orientation="Horizontal" Margin="12,0,0,42">
       <TextBlock Text="SONORA" FontSize="24" FontWeight="Bold" Foreground="White" CharacterSpacing="90"/>
       <Border Width="5" Height="5" Background="#176BFF" Margin="7,0,0,2" VerticalAlignment="Bottom"/>
      </StackPanel>
      <TextBlock Text="РАЗДЕЛЫ" Foreground="#4F5968" FontSize="9" FontWeight="Bold" Margin="14,0,0,10"/>
      <Button Style="{StaticResource NavButton}" Content="⌂    Главная" Click="Home_Click"/>
      <Button Style="{StaticResource NavButton}" Content="⌕    Поиск" Click="Search_Click"/>
      <Button Style="{StaticResource NavButton}" Content="▤    Моя музыка" Click="Library_Click"/>
      <Button Style="{StaticResource NavButton}" Content="♡    Избранное" Click="Favorites_Click"/>
      <Button Style="{StaticResource NavButton}" Content="♫    Плейлисты" Click="Playlists_Click"/>
      <TextBlock Text="КОЛЛЕКЦИЯ" Foreground="#4F5968" FontSize="9" FontWeight="Bold" Margin="14,30,0,10"/>
      <Button Style="{StaticResource NavButton}" Content="＋    Добавить музыку" Click="AddMusic_Click"/>
      <Button Style="{StaticResource NavButton}" Content="⌁    Музыкальные сервисы" Click="Services_Click"/>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="12,0,0,0">
      <Border Height="1" Background="#1A1F28" Margin="0,0,0,14"/>
      <TextBlock Text="SONORA DESKTOP" Foreground="#697383" FontSize="9" FontWeight="Bold"/>
      <TextBlock Text="Музыка без границ" Foreground="#3F4855" FontSize="10" Margin="0,5,0,0"/>
     </StackPanel>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1" Margin="38,28,38,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,28">
     <StackPanel>
      <TextBlock x:Name="GreetingText" Text="Твоя музыка." FontSize="30" FontWeight="Bold" Foreground="#FFFFFF"/>
      <TextBlock x:Name="SubtitleText" Text="Всё, что ты слушаешь, в одном месте." Foreground="#747D8A" Margin="0,7,0,0" FontSize="13"/>
     </StackPanel>
     <Border HorizontalAlignment="Right" VerticalAlignment="Center" BorderBrush="#176BFF" BorderThickness="1,0,0,0" Padding="12,7" Background="#05080D">
      <TextBlock Text="●  ЛОКАЛЬНАЯ БИБЛИОТЕКА" Foreground="#6EA4FF" FontSize="9" FontWeight="Bold"/>
     </Border>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <Grid Margin="0,0,0,34" MinHeight="142">
       <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
       <Border Background="#176BFF"/>
       <StackPanel Grid.Column="1" Margin="22,8,0,8" VerticalAlignment="Center">
        <TextBlock Text="SONORA / YOUR MUSIC" Foreground="#4F91FF" FontSize="10" FontWeight="Bold"/>
        <TextBlock Text="Твоя коллекция звучит здесь." FontSize="26" FontWeight="Bold" Margin="0,10,0,5"/>
        <TextBlock Text="Добавляй локальные треки, собирай плейлисты и управляй воспроизведением." Foreground="#7E8794" FontSize="12" TextWrapping="Wrap" MaxWidth="620"/>
        <Button Content="＋  ИМПОРТИРОВАТЬ МУЗЫКУ" Background="#176BFF" BorderBrush="#176BFF" Foreground="White" Padding="16,10" HorizontalAlignment="Left" Margin="0,17,0,0" Click="AddMusic_Click"/>
       </StackPanel>
       <Image Grid.Column="2" Source="/SONORA;component/Assets/sonora.png" Width="112" Height="112" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.92"/>
      </Grid>
      <Grid Margin="0,0,0,15">
       <StackPanel>
        <TextBlock Text="БИБЛИОТЕКА" FontSize="10" FontWeight="Bold" Foreground="#4F91FF"/>
        <TextBlock Text="Все треки" FontSize="23" FontWeight="Bold" Margin="0,5,0,0"/>
        <TextBlock x:Name="TrackCountText" Text="0 треков" Foreground="#747D8A" FontSize="11" Margin="0,4,0,0"/>
       </StackPanel>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <ComboBox x:Name="SortBox" Width="132" Height="32" SelectedIndex="0" Background="#050505" Foreground="White" BorderBrush="#252B35" BorderThickness="1" Margin="0,0,8,0" SelectionChanged="SortBox_SelectionChanged">
         <ComboBoxItem Content="Название"/>
         <ComboBoxItem Content="Исполнитель"/>
         <ComboBoxItem Content="Альбом"/>
         <ComboBoxItem Content="Год"/>
        </ComboBox>
        <ComboBox x:Name="GroupBox" Width="118" Height="32" SelectedIndex="0" Background="#050505" Foreground="White" BorderBrush="#252B35" BorderThickness="1" Margin="0,0,12,0" SelectionChanged="GroupBox_SelectionChanged">
         <ComboBoxItem Content="Без групп"/>
         <ComboBoxItem Content="Исполнители"/>
         <ComboBoxItem Content="Альбомы"/>
         <ComboBoxItem Content="Жанры"/>
        </ComboBox>
        <TextBlock x:Name="FavoriteCountText" Text="0 избранных" Foreground="#747D8A" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Button x:Name="FavoriteButton" Content="♡" Padding="12,7" BorderBrush="#252B35" Click="Favorite_Click"/>
        <Button Content="＋ Плейлист" Padding="12,7" Margin="7,0,0,0" BorderBrush="#252B35" Click="AddToPlaylist_Click"/>
       </StackPanel>
      </Grid>
      <Grid Margin="0,0,0,12">
       <TextBox x:Name="SearchBox" Height="42" Padding="13,10" Background="#050505" Foreground="#E8EDF5" BorderBrush="#252B35" BorderThickness="1" FontSize="13" ToolTip="Поиск по локальной библиотеке" TextChanged="SearchBox_TextChanged"/>
       <TextBlock Text="⌕" Foreground="#657184" FontSize="18" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
      </Grid>
      <Grid Margin="0,0,0,5">
       <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
       <TextBlock Grid.Column="1" Text="НАЗВАНИЕ" Foreground="#515B69" FontSize="9" FontWeight="Bold" Margin="4,0,0,0"/>
       <TextBlock Grid.Column="2" Text="ИСПОЛНИТЕЛЬ" Foreground="#515B69" FontSize="9" FontWeight="Bold"/>
       <TextBlock Grid.Column="3" Text="АЛЬБОМ" Foreground="#515B69" FontSize="9" FontWeight="Bold"/>
       <TextBlock Grid.Column="4" Text="ВРЕМЯ" Foreground="#515B69" FontSize="9" FontWeight="Bold"/>
      </Grid>
      <Border BorderBrush="#20252D" BorderThickness="0,1,0,0">
       <ListView x:Name="TracksList" Background="Transparent" BorderThickness="0" Foreground="White" SelectionMode="Single" MouseDoubleClick="TracksList_DoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListView.ItemContainerStyle>
         <Style TargetType="ListViewItem">
          <Setter Property="Padding" Value="8,8"/>
          <Setter Property="Margin" Value="0"/>
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="BorderThickness" Value="0,0,0,1"/>
          <Setter Property="BorderBrush" Value="#11151B"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
           <Border x:Name="itemBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
           <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#080D17"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#0B1A32"/><Setter TargetName="itemBorder" Property="BorderBrush" Value="#176BFF"/></Trigger>
           </ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter>
         </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate><DataTemplate>
         <Grid MinHeight="48">
          <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
          <Border Width="36" Height="36" Background="#080D17" ClipToBounds="True"><Image Source="{Binding ArtworkPath}" Stretch="UniformToFill"/></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,8,0">
           <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#F4F6FA" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{Binding Genre}" Foreground="#626D7C" FontSize="10" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding Artist}" Foreground="#A0A8B4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Column="3" Text="{Binding Album}" Foreground="#7D8794" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Column="4" Text="{Binding DurationText}" Foreground="#697483" VerticalAlignment="Center" HorizontalAlignment="Right"/>
         </Grid>
        </DataTemplate></ListView.ItemTemplate>
       </ListView>
      </Border>
      <TextBlock x:Name="EmptyStateText" Text="Библиотека пуста. Добавь музыку, чтобы она появилась здесь." Foreground="#737D8B" TextAlignment="Center" Margin="0,24,0,0" FontSize="12"/>
     </StackPanel>
    </ScrollViewer>
   </Grid>
  </Grid>
  <Border Grid.Row="1" Background="#030303" BorderBrush="#176BFF" BorderThickness="0,1,0,0" Padding="22,11">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="52" Height="52" Background="#080D17" ClipToBounds="True"><Image x:Name="NowPlayingArtwork" Stretch="UniformToFill"/></Border>
     <StackPanel VerticalAlignment="Center" Margin="13,0,0,0">
      <TextBlock x:Name="NowPlayingTitle" Text="Ничего не воспроизводится" FontWeight="SemiBold" FontSize="12" Foreground="#F5F7FA"/>
      <TextBlock x:Name="NowPlayingArtist" Text="Выбери трек из библиотеки" Foreground="#747D8A" FontSize="10" Margin="0,4,0,0"/>
     </StackPanel>
     <Button Content="↗" ToolTip="Открыть экран воспроизведения" Width="30" Height="30" Margin="10,0,0,0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Click="OpenNowPlaying_Click"/>
    </StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="390">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <Button x:Name="ShuffleButton" Content="SHF" Foreground="#7B8797" FontSize="9" Background="Transparent" BorderThickness="0" Padding="9,5" Click="Shuffle_Click"/>
      <Button Content="|◀" FontSize="15" Background="Transparent" BorderThickness="0" Padding="10,4" Click="Previous_Click"/>
      <Button x:Name="PlayPauseButton" Content="▶" Background="#176BFF" BorderBrush="#176BFF" Foreground="White" Padding="17,8" Margin="10,0" Click="PlayPause_Click"/>
      <Button Content="▶|" FontSize="15" Background="Transparent" BorderThickness="0" Padding="10,4" Click="Next_Click"/>
      <Button x:Name="RepeatButton" Content="REP" Foreground="#7B8797" FontSize="9" Background="Transparent" BorderThickness="0" Padding="9,5" Click="Repeat_Click"/>
     </StackPanel>
     <Grid Margin="0,8,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="CurrentTimeText" Text="0:00" FontSize="9" Foreground="#657184" VerticalAlignment="Center"/>
      <Slider x:Name="SeekSlider" Grid.Column="1" Height="16" Minimum="0" Maximum="1" Value="0" VerticalAlignment="Center" IsMoveToPointEnabled="True" ValueChanged="SeekSlider_ValueChanged" PreviewMouseLeftButtonDown="SeekSlider_MouseDown" PreviewMouseLeftButtonUp="SeekSlider_MouseUp"/>
      <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" FontSize="9" Foreground="#657184" HorizontalAlignment="Right" VerticalAlignment="Center"/>
     </Grid>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <TextBlock Text="VOL" Foreground="#687383" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
     <Slider x:Name="VolumeSlider" Width="112" Minimum="0" Maximum="1" Value="0.75" ValueChanged="VolumeSlider_ValueChanged"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
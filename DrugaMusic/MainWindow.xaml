<Window x:Class="DrugaMusic.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SONORA" Icon="Assets/sonora.ico" Width="1400" Height="900" MinWidth="1080" MinHeight="720"
 WindowStartupLocation="CenterScreen" Background="#07090E" Foreground="{StaticResource TextBrush}"
 FontFamily="/SONORA;component/Assets/#Widock">
 <Grid Background="#07090E">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="96"/></Grid.RowDefinitions>
  <Grid Grid.Row="0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#090C13" BorderBrush="#1A2331" BorderThickness="0,0,1,0">
    <DockPanel Margin="18,24,16,18">
     <StackPanel DockPanel.Dock="Top">
      <StackPanel Orientation="Horizontal" Margin="12,2,0,40">
       <TextBlock Text="SONORA" FontSize="25" Foreground="White" FontWeight="Bold"/>
       <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource AccentGradient}" Margin="7,0,0,4" VerticalAlignment="Bottom"/>
      </StackPanel>
      <TextBlock Text="ТВОЯ МУЗЫКА" Foreground="#53647B" FontSize="9" Margin="14,0,0,11"/>
      <Button Style="{StaticResource NavButton}" Content="⌂   Главная" Click="Home_Click"/>
      <Button Style="{StaticResource NavButton}" Content="⌕   Поиск" Click="Search_Click"/>
      <Button Style="{StaticResource NavButton}" Content="▤   Моя музыка" Click="Library_Click"/>
      <Button Style="{StaticResource NavButton}" Content="♡   Избранное" Click="Favorites_Click"/>
      <Button Style="{StaticResource NavButton}" Content="♫   Плейлисты" Click="Playlists_Click"/>
      <TextBlock Text="КОЛЛЕКЦИЯ" Foreground="#53647B" FontSize="9" Margin="14,30,0,11"/>
      <Button Style="{StaticResource NavButton}" Content="＋   Добавить музыку" Click="AddMusic_Click"/>
      <Button Style="{StaticResource NavButton}" Content="⌁   Аккаунт и сервисы" Click="Services_Click"/>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="12,0,0,0">
      <Border Height="1" Background="#1A2331" Margin="0,0,0,14"/>
      <TextBlock Text="SONORA DESKTOP" Foreground="#60718A" FontSize="9"/>
      <TextBlock Text="Твоя музыка. Твоё пространство." Foreground="#3E4A5D" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/>
     </StackPanel>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1" Margin="34,24,34,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,22">
     <StackPanel>
      <TextBlock x:Name="GreetingText" Text="Твоя музыка. Твоё пространство." FontSize="29" Foreground="#F7F9FD" FontWeight="Bold"/>
      <TextBlock x:Name="SubtitleText" Text="Подборки, артисты и всё, что ты любишь слушать." Foreground="#8491A5" Margin="0,7,0,0" FontSize="12"/>
     </StackPanel>
     <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#101A2A" BorderBrush="#28466F" BorderThickness="1" Padding="12,7">
      <StackPanel Orientation="Horizontal">
       <Ellipse Width="6" Height="6" Fill="#54A2FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
       <TextBlock Text="ТВОЯ БИБЛИОТЕКА" Foreground="#9BC5FF" FontSize="9"/>
      </StackPanel>
     </Border>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <Border CornerRadius="3" Padding="26,22" Margin="0,0,0,24" MinHeight="166">
       <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
         <GradientStop Color="#102B59" Offset="0"/>
         <GradientStop Color="#124C9D" Offset="0.48"/>
         <GradientStop Color="#10213B" Offset="1"/>
        </LinearGradientBrush>
       </Border.Background>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
         <TextBlock Text="SONORA  /  YOUR SOUNDTRACK" Foreground="#B6D8FF" FontSize="10"/>
         <TextBlock Text="Включай своё." FontSize="30" Foreground="White" FontWeight="Bold" Margin="0,9,0,4"/>
         <TextBlock Text="Собери любимые треки, открывай новые сочетания и слушай без лишнего." Foreground="#D3E5FF" FontSize="12" TextWrapping="Wrap" MaxWidth="610"/>
         <Button Content="＋   ДОБАВИТЬ МУЗЫКУ" Background="{StaticResource AccentGradient}" BorderBrush="#69AEFF" Foreground="White" Padding="16,10" HorizontalAlignment="Left" Margin="0,17,0,0" Click="AddMusic_Click"/>
        </StackPanel>
        <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Width="144" Height="120">
         <Ellipse Width="118" Height="118" Fill="#162D54" Opacity="0.8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         <Ellipse Width="88" Height="88" Fill="#245EAC" Opacity="0.8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         <Image Source="/SONORA;component/Assets/sonora.png" Width="78" Height="78" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
       </Grid>
      </Border>
      <Grid Margin="0,0,0,9">
       <StackPanel>
        <TextBlock Text="ТВОЙ МУЗЫКАЛЬНЫЙ МИР" Foreground="#589CFA" FontSize="9"/>
        <TextBlock Text="Исполнители" FontSize="21" FontWeight="Bold" Margin="0,4,0,0"/>
       </StackPanel>
       <TextBlock Text="ИЗ ТВОЕЙ БИБЛИОТЕКИ" Foreground="#66758A" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
      </Grid>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="-4,0,-4,18">
       <ItemsControl x:Name="ArtistsList">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
         <StackPanel Width="112" Margin="4,7,10,8">
          <Border Width="88" Height="88" CornerRadius="44" Background="#14233A" BorderBrush="#294B78" BorderThickness="1" HorizontalAlignment="Center" ClipToBounds="True">
           <Image Source="{Binding ArtworkPath}" Stretch="UniformToFill"/>
          </Border>
          <TextBlock Text="{Binding Name}" Foreground="#EAF1FC" FontSize="11" TextAlignment="Center" Margin="0,8,0,2" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding TrackCountText}" Foreground="#728198" FontSize="9" TextAlignment="Center"/>
         </StackPanel>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </ScrollViewer>
      <Grid Margin="0,0,0,9">
       <StackPanel>
        <TextBlock Text="ТВОЯ КОЛЛЕКЦИЯ" Foreground="#589CFA" FontSize="9"/>
        <TextBlock Text="Плейлисты" FontSize="21" FontWeight="Bold" Margin="0,4,0,0"/>
       </StackPanel>
       <Button Content="УПРАВЛЯТЬ  ↗" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" BorderBrush="#263B59" Foreground="#A9CFFF" FontSize="9" Padding="10,6" Click="Playlists_Click"/>
      </Grid>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="-4,0,-4,20">
       <ItemsControl x:Name="PlaylistCards">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
         <Border Width="184" Height="104" Margin="4,6,10,8" Padding="13" CornerRadius="3" BorderBrush="#263B59" BorderThickness="1">
          <Border.Background>
           <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#183D70" Offset="0"/>
            <GradientStop Color="#101B2D" Offset="1"/>
           </LinearGradientBrush>
          </Border.Background>
          <Grid>
           <StackPanel VerticalAlignment="Bottom">
            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding TrackIds.Count, StringFormat={}{0} треков}" Foreground="#A7C9F4" FontSize="10" Margin="0,5,0,0"/>
           </StackPanel>
           <TextBlock Text="♫" Foreground="#B9D9FF" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.8"/>
          </Grid>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </ScrollViewer>
      <Grid Margin="0,0,0,12">
       <StackPanel>
        <TextBlock Text="ТВОЯ МУЗЫКА" Foreground="#589CFA" FontSize="9"/>
        <TextBlock Text="Все треки" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
        <TextBlock x:Name="TrackCountText" Text="0 треков" Foreground="#8491A5" FontSize="10" Margin="0,4,0,0"/>
       </StackPanel>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <ComboBox x:Name="SortBox" Width="116" Height="31" SelectedIndex="0" Background="#0D111A" Foreground="White" BorderBrush="#2A3B54" Margin="0,0,7,0" SelectionChanged="SortBox_SelectionChanged">
         <ComboBoxItem Content="Название"/><ComboBoxItem Content="Исполнитель"/><ComboBoxItem Content="Альбом"/><ComboBoxItem Content="Год"/>
        </ComboBox>
        <ComboBox x:Name="GroupBox" Width="108" Height="31" SelectedIndex="0" Background="#0D111A" Foreground="White" BorderBrush="#2A3B54" Margin="0,0,8,0" SelectionChanged="GroupBox_SelectionChanged">
         <ComboBoxItem Content="Без групп"/><ComboBoxItem Content="Исполнители"/><ComboBoxItem Content="Альбомы"/><ComboBoxItem Content="Жанры"/>
        </ComboBox>
        <TextBlock x:Name="FavoriteCountText" Text="0 избранных" Foreground="#8491A5" FontSize="10" VerticalAlignment="Center" Margin="0,0,9,0"/>
        <Button x:Name="FavoriteButton" Content="♡" Padding="10,6" BorderBrush="#2A3B54" Click="Favorite_Click"/>
       </StackPanel>
      </Grid>
      <Grid Margin="0,0,0,12">
       <TextBox x:Name="SearchBox" Height="40" Padding="13,9" Background="#0D111A" Foreground="#E8EDF5" BorderBrush="#26364D" BorderThickness="1" FontSize="12" ToolTip="Поиск по локальной библиотеке" TextChanged="SearchBox_TextChanged"/>
       <TextBlock Text="⌕" Foreground="#7185A1" FontSize="18" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
      </Grid>
      <Grid Margin="0,0,0,7">
       <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
       <TextBlock Grid.Column="1" Text="НАЗВАНИЕ" Foreground="#62748D" FontSize="9" Margin="4,0,0,0"/>
       <TextBlock Grid.Column="2" Text="ИСПОЛНИТЕЛЬ" Foreground="#62748D" FontSize="9"/>
       <TextBlock Grid.Column="3" Text="АЛЬБОМ" Foreground="#62748D" FontSize="9"/>
       <TextBlock Grid.Column="4" Text="ВРЕМЯ" Foreground="#62748D" FontSize="9"/>
      </Grid>
      <Border BorderBrush="#24334A" BorderThickness="0,1,0,0">
       <ListView x:Name="TracksList" Background="Transparent" BorderThickness="0" Foreground="White" SelectionMode="Single" MouseDoubleClick="TracksList_DoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
         <Setter Property="Padding" Value="8,7"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="Transparent"/>
         <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#182131"/>
         <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
          <Border x:Name="itemBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
          <ControlTemplate.Triggers>
           <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#101A2A"/></Trigger>
           <Trigger Property="IsSelected" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#122A4A"/><Setter TargetName="itemBorder" Property="BorderBrush" Value="#347FE0"/></Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate></Setter.Value></Setter>
        </Style></ListView.ItemContainerStyle>
        <ListView.ItemTemplate><DataTemplate>
         <Grid MinHeight="48">
          <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
          <Border Width="36" Height="36" Background="#14233A" ClipToBounds="True"><Image Source="{Binding ArtworkPath}" Stretch="UniformToFill"/></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,8,0">
           <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#F4F7FC" TextTrimming="CharacterEllipsis" FontSize="11"/>
           <TextBlock Text="{Binding Genre}" Foreground="#75849A" FontSize="9" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding Artist}" Foreground="#AAB6C8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="10"/>
          <TextBlock Grid.Column="3" Text="{Binding Album}" Foreground="#8492A7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="10"/>
          <TextBlock Grid.Column="4" Text="{Binding DurationText}" Foreground="#8492A7" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="10"/>
         </Grid>
        </DataTemplate></ListView.ItemTemplate>
       </ListView>
      </Border>
      <TextBlock x:Name="EmptyStateText" Text="Библиотека пуста. Добавь музыку, чтобы увидеть здесь свои треки." Foreground="#8290A5" TextAlignment="Center" Margin="0,24,0,20" FontSize="11"/>
     </StackPanel>
    </ScrollViewer>
   </Grid>
  </Grid>
  <Border Grid.Row="1" Background="#090D15" BorderBrush="#263C5C" BorderThickness="0,1,0,0" Padding="22,10">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="54" Height="54" Background="#14233A" ClipToBounds="True"><Image x:Name="NowPlayingArtwork" Stretch="UniformToFill"/></Border>
     <StackPanel VerticalAlignment="Center" Margin="13,0,0,0">
      <TextBlock x:Name="NowPlayingTitle" Text="Ничего не воспроизводится" FontWeight="Bold" FontSize="11" Foreground="#F5F7FC"/>
      <TextBlock x:Name="NowPlayingArtist" Text="Выбери трек из библиотеки" Foreground="#8491A5" FontSize="9" Margin="0,4,0,0"/>
     </StackPanel>
     <Button Content="↗" ToolTip="Открыть экран воспроизведения" Width="30" Height="30" Margin="10,0,0,0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Click="OpenNowPlaying_Click"/>
    </StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="390">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <Button x:Name="ShuffleButton" Content="SHF" Foreground="#8A9AB1" FontSize="9" Background="Transparent" BorderThickness="0" Padding="9,5" Click="Shuffle_Click"/>
      <Button Content="|◀" FontSize="15" Background="Transparent" BorderThickness="0" Padding="10,4" Click="Previous_Click"/>
      <Button x:Name="PlayPauseButton" Content="▶" Background="{StaticResource AccentGradient}" BorderBrush="#64A9FF" Foreground="White" Padding="17,8" Margin="10,0" Click="PlayPause_Click"/>
      <Button Content="▶|" FontSize="15" Background="Transparent" BorderThickness="0" Padding="10,4" Click="Next_Click"/>
      <Button x:Name="RepeatButton" Content="REP" Foreground="#8A9AB1" FontSize="9" Background="Transparent" BorderThickness="0" Padding="9,5" Click="Repeat_Click"/>
     </StackPanel>
     <Grid Margin="0,7,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="CurrentTimeText" Text="0:00" FontSize="9" Foreground="#72829A" VerticalAlignment="Center"/>
      <Slider x:Name="SeekSlider" Grid.Column="1" Height="16" Minimum="0" Maximum="1" Value="0" VerticalAlignment="Center" IsMoveToPointEnabled="True" ValueChanged="SeekSlider_ValueChanged" PreviewMouseLeftButtonDown="SeekSlider_MouseDown" PreviewMouseLeftButtonUp="SeekSlider_MouseUp"/>
      <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" FontSize="9" Foreground="#72829A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
     </Grid>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <TextBlock Text="VOL" Foreground="#72829A" FontSize="9" VerticalAlignment="Center" Margin="0,0,10,0"/>
     <Slider x:Name="VolumeSlider" Width="112" Minimum="0" Maximum="1" Value="0.75" ValueChanged="VolumeSlider_ValueChanged"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>